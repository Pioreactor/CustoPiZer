[Unit]
Description=Configure local link over ethernet
# Wait for everyboot and NetworkManager, then run before the network is considered online.
After=everyboot.service NetworkManager.service
Before=network-online.target
ConditionPathExists=/boot/firmware/local_link

[Service]
Type=oneshot
ExecStart=/bin/bash /usr/local/bin/local_link.sh
# If the script hangs, fail after 60 seconds instead of blocking the boot indefinitely.
TimeoutSec=60
RemainAfterExit=yes
Restart=on-failure
RestartSec=15

[Install]
# Tie this to network-online.target so that the network is only reported as online once this has run.
WantedBy=network-online.target
