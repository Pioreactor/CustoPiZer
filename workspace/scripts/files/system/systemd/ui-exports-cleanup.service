[Unit]
Description=Cleanup UI exports directory

[Service]
Type=oneshot
User=pioreactor
EnvironmentFile=/etc/pioreactor.env
ExecStart=/bin/bash -lc 'pio log -m "Cleaning web exports dir" -l info && rm -f "$DOT_PIOREACTOR"/web/exports/*.zip "$DOT_PIOREACTOR"/web/exports/*.csv'

[Install]
WantedBy=multi-user.target
