[Unit]
Description=Cleanup web exports directory (leaders)

[Service]
Type=oneshot
User=pioreactor
# Ephemeral exports live in /run; DOT_PIOREACTOR is not used here
ExecStart=/bin/bash -lc 'pio log -m "Cleaning web exports dir" -l info && rm -f /run/pioreactor/exports/*.zip /run/pioreactor/exports/*.csv'

[Install]
WantedBy=multi-user.target
